# Copy to .env and adjust. Never commit real secrets.
DJANGO_SETTINGS_MODULE=config.settings.development

# REQUIRED: Secret key for Django cryptographic operations (CSRF, sessions, password reset)
# Linux / Render:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Must be at least 50 characters, keep it secret!
DJANGO_SECRET_KEY=your-secret-key-here

# REQUIRED: Separate signing key for JWT tokens (MUST differ from DJANGO_SECRET_KEY)
# Linux / Render shell (bash):  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Windows (PowerShell):         python -c "import secrets; print(secrets.token_urlsafe(64))"
# No uses `py` ni `pyton`. El valor va en este archivo o en Render → Environment (Secret); no en $JWT_SIGNING_KEY=... en bash (eso no persiste al servicio web).
# If not set, falls back to DJANGO_SECRET_KEY in development with a warning.
JWT_SIGNING_KEY=

# JWT access/refresh lifetimes (cookies follow these unless AUTH_JWT_SESSION_COOKIES=true).
# JWT_ACCESS_MINUTES=1440
# JWT_REFRESH_DAYS=14
# Dev default: session cookies (cleared when browser closes); production should use false + HTTPS.
# AUTH_JWT_SESSION_COOKIES=false

# ALLOWED_HOSTS: comma-separated list of allowed hostnames
# NEVER use '*' — it enables Host header injection attacks
ALLOWED_HOSTS=localhost,127.0.0.1,localtest.me

# PostgreSQL (django-tenants requires PostgreSQL; SQLite is not supported)
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp  # Change this! Never use default in production.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Mercado Pago (registro plan starter, suscripción mensual). Si está vacío, create-checkout responde 503 y el front puede usar registro directo en desarrollo.
# MERCADOPAGO_ACCESS_TOKEN=
# URL pública del API para webhooks (HTTPS en producción; ngrok en pruebas).
# BACKEND_PUBLIC_URL=http://127.0.0.1:8000
# FRONTEND_BASE_URL=http://localhost:5173
# En producción (Render): si defines FRONTEND_BASE_URL=https://tu-static.onrender.com en el *servicio API*,
# production.py la fusiona en CORS_ALLOWED_ORIGINS y CSRF_TRUSTED_ORIGINS (evita duplicar listas).
# Registro starter sin MP (solo desarrollo)
# ALLOW_REGISTER_WITHOUT_PAYMENT=false
# STARTER_PLAN_BASE_MXN=200.00
# STARTER_PLAN_IVA_RATE=0.16

# Cloudflare R2 — fotos de órdenes de servicio / levantamiento (reemplazo de Cloudinary).
# Crea un bucket R2 y una API token con permiso de lectura/escritura en ese bucket.
# Endpoint usado en código: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ACCOUNT_ID=
# R2_BUCKET=nombre-del-bucket
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Órdenes / cotizaciones / servicios en este repo usan el módulo ops_stubs (caché) salvo override.
# Las rutas /api/ordenes/* (incl. upload-image a R2) solo existen si está en true.
# En producción (Render, etc.) pon ENABLE_OPS_STUBS=true hasta migrar órdenes a base de datos real.
# ENABLE_OPS_STUBS=true

# -----------------------------------------------------------------------------
# Render (producción) — Web Service, Root Directory: backend
# -----------------------------------------------------------------------------
# Render inyecta RENDER=true: si no defines DJANGO_SETTINGS_MODULE, el proyecto
# usa config.settings.production (wsgi/manage/asgi). Sigue siendo buena práctica
# definir DJANGO_SETTINGS_MODULE en el dashboard.
#
# En el shell de Render (Linux) usa `python` o `python3`, no `py` (solo Windows).
# Generar secretos y copiar la SALIDA al dashboard (Environment → Secret). Eso no configura el servicio web:
#
#   DJANGO_SECRET_KEY — debe ser largo (50+). Opción Django:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
#   JWT_SIGNING_KEY — distinto del anterior; estándar:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# No escribas: $JWT_SIGNING_KEY = python ...  (eso es PowerShell). En bash sería export JWT_SIGNING_KEY="..." solo para esa sesión del shell; en Render lo habitual es pegar en el panel.
# (Si al pegar ves ^[[200~, pega de nuevo sin modo bracketed o escribe el comando a mano.)
#
# En Render: conecta una base PostgreSQL (inyecta DATABASE_URL). Alternativa: POSTGRES_*.
#
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_SECRET_KEY=<pegar salida de get_random_secret_key()>
# JWT_SIGNING_KEY=<pegar salida de secrets.token_urlsafe(64); distinto de DJANGO_SECRET_KEY>
# ALLOWED_HOSTS=tu-servicio.onrender.com,tudominio.com
# Render define RENDER_EXTERNAL_URL; en producción se añade automáticamente ese hostname a ALLOWED_HOSTS
# si falta (útil para health checks sin duplicar el nombre del servicio).
# CSRF_TRUSTED_ORIGINS=https://tu-frontend.onrender.com,https://tudominio.com
# CORS_ALLOWED_ORIGINS=https://tu-frontend.onrender.com,https://tudominio.com
# Alternativa: solo FRONTEND_BASE_URL=https://tu-frontend.onrender.com (mismo origen; ver comentario arriba).
# En Render, si CORS/CSRF están vacíos, production.py añade el origen de RENDER_EXTERNAL_URL (URL del API)
# para que el servicio arranque; el static site es otro host: usa FRONTEND_BASE_URL o lista explícita aquí.
#
# Health check (Render): Health Check Path = /healthz  (también existe /api/health/)
# Responde 200 sin tocar la tabla Domain (middleware HealthCheckMiddleware); el resto
# de rutas sigue exigiendo dominio en organizations.Domain o SHOW_PUBLIC_IF_NO_TENANT_FOUND.
#
# Superusuario en el primer deploy (Pre-Deploy ya corre migrate + ensure_superuser):
#   ENSURE_SUPERUSER=1
#   DJANGO_SUPERUSER_USERNAME=AngelPerez10
#   DJANGO_SUPERUSER_EMAIL=tu@email.com
#   DJANGO_SUPERUSER_PASSWORD=<solo en el panel de Render, Secret; no subir a git>
# Tras el primer deploy exitoso puedes poner ENSURE_SUPERUSER=0 para no volver a evaluar.
#
# Si el health check falla por multi-tenant: hasta tener un Domain para tu host API,
#   SHOW_PUBLIC_IF_NO_TENANT_FOUND=true  (luego pásalo a false).
#
# Build:  pip install --upgrade pip && pip install -r requirements.txt && pip install "gunicorn==23.0.0"
# Start:  python -m gunicorn config.wsgi:application --bind 0.0.0.0:$PORT --workers 1 --threads 4 --timeout 120
# Pre-Deploy:  python manage.py migrate --noinput && python manage.py ensure_superuser
#
# Blueprint de ejemplo en la raíz del repo: render.yaml
